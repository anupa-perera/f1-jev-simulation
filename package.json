{
  "name": "f1-jev-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chronological Formula 1 prediction and Jev versus OpenAI model comparison",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test",
    "ui:build": "vite build",
    "ui:dev": "vite",
    "pretest": "vite build",
    "predashboard": "vite build",
    "predashboard:export": "vite build",
    "demo": "node src/cli.js demo",
    "dashboard": "node --env-file-if-exists=.env --use-system-ca src/cli.js dashboard",
    "dashboard:export": "node --env-file-if-exists=.env src/cli.js export-dashboard",
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "collect": "node --env-file-if-exists=.env --use-system-ca src/cli.js collect",
    "compare": "node --env-file-if-exists=.env --use-system-ca src/cli.js compare",
    "next": "node --env-file-if-exists=.env --use-system-ca src/cli.js next",
    "benchmark": "node --env-file-if-exists=.env --use-system-ca src/cli.js benchmark",
    "rounds": "node --env-file-if-exists=.env --use-system-ca src/cli.js rounds",
    "audit": "node scripts/audit-taxonomy.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
