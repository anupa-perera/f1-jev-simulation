# TypeSafe Jev. Pin the model so comparisons can be reproduced.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key
TYPESAFE_MODEL=jev-1.13.0

# OpenAI requests are routed through `codex exec`, which reuses `codex login`.
# Do not copy ~/.codex/auth.json or place an OAuth token here.
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
# CODEX_BIN=C:\path\to\codex-executable

# Optional. Application data stays outside the repository by default.
# F1_JEV_DATA_DIR=C:\Users\your-name\.codex\f1-jev-simulation
# F1_JEV_PORT=4317
